<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>QoL</RootNamespace>
    <AssemblyName>QuadruplicationOfLikeability</AssemblyName>
    <OutputPath>..\Output\QoL_Mod\BepInEx\plugins\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoW_ModAPI\PoW_ModAPI.csproj" Private="false" />
  </ItemGroup>

  <!-- Compile only: everything below is already in the game or BepInEx, so nothing is copied to the output -->
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(BepInExCore)0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDependencies)Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameDependencies)Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="BehaviourMachineRuntime" HintPath="$(GameDependencies)BehaviourMachineRuntime.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameDependencies)UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameDependencies)UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDependencies)UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameDependencies)UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameDependencies)UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>
