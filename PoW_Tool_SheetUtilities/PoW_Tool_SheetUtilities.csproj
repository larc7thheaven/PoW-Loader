<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PoW_Tool_SheetUtilities</RootNamespace>
    <AssemblyName>SheetUtilities</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <OutputPath>..\Output\Tools\SheetUtilities\</OutputPath>
  </PropertyGroup>

  <!-- Unfinished or replaced handlers and translators that are not part of the tool -->
  <ItemGroup>
    <Compile Remove="Handler\TextAssets\AnimationMappingAssetHandler.cs" />
    <Compile Remove="Handler\TextAssets\BattleEventCubeAssetHandler.cs" />
    <Compile Remove="Handler\TextAssets\BattleGridAssetHandler.cs" />
    <Compile Remove="Handler\TextAssets\BattlePortraitVoiceAssetHandler.cs" />
    <Compile Remove="Handler\TextAssets\BufferTableAssetHandler.cs" />
    <Compile Remove="Handler\TextAssets\CuisineAssetHandler.cs" />
    <Compile Remove="Handler\TextAssets\NpcVoiceAssetHandler.cs" />
    <Compile Remove="MachineTranslator\BingTranslator.cs" />
    <Compile Remove="MachineTranslator\GoogleTranslator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepL.net" Version="1.5.0" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.57.0.2826" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="Yandex.Translator" Version="2.0.0" />
  </ItemGroup>

  <!-- Dependencies of the packages above, pinned to the versions the tool shipped with before (packages.config) -->
  <ItemGroup>
    <PackageReference Include="Catharsis.Commons" Version="4.0.1" />
    <PackageReference Include="Google.Apis" Version="1.58.0-beta02" />
    <PackageReference Include="Google.Apis.Auth" Version="1.58.0-beta02" />
    <PackageReference Include="Google.Apis.Core" Version="1.58.0-beta02" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="7.0.0" />
    <PackageReference Include="Polly" Version="7.2.3" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="RestSharp" Version="112.0.0" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="7.0.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="7.0.0-preview.2.22152.2" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
