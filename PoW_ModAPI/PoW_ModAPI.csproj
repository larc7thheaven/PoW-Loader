<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>PoW_ModAPI</RootNamespace>
    <AssemblyName>PoW_ModAPI</AssemblyName>
    <!-- The solution builds the plugins as x64, the assembly itself stays AnyCPU -->
    <Platforms>x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\Output\Mod\BepInEx\plugins\</OutputPath>
  </PropertyGroup>

  <!-- Compile only: everything below is already in the game, BepInEx or the XUnity plugin, so nothing is copied to the output -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="FileHelpers" Version="3.5.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameDependencies)Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameDependencies)Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="BehaviourMachineRuntime" HintPath="$(GameDependencies)BehaviourMachineRuntime.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameDependencies)UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(GameDependencies)UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDependencies)UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameDependencies)UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameDependencies)UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameDependencies)UnityEngine.UI.dll" Private="false" />
    <Reference Include="XUnity.ResourceRedirector" HintPath="..\Output\Mod\BepInEx\plugins\XUnity.ResourceRedirector\XUnity.ResourceRedirector.dll" Private="false" />
  </ItemGroup>
</Project>
